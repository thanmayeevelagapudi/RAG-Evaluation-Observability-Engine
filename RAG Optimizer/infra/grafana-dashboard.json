{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel",      "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel",      "id": "stat",        "name": "Stat",        "version": "" },
    { "type": "panel",      "id": "bargauge",    "name": "Bar gauge",   "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Adaptive RAG Retrieval & Eval Platform — 6-panel operations dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [

    {
      "id": 1,
      "type": "bargauge",
      "title": "Strategy Selection (last 24 h)",
      "description": "Which strategy the bandit chose per query type. Cold-start shows uniform distribution; a trained bandit shows a clear winner per row.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (strategy, query_type) (increase(rag_queries_total[24h]))",
          "legendFormat": "{{query_type}} / {{strategy}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 100 }
          ]}
        },
        "overrides": []
      }
    },

    {
      "id": 2,
      "type": "timeseries",
      "title": "Strategy Score Over Time (bandit learning curve)",
      "description": "Running average score per (strategy, query_type) pair stored in strategy_weights. Starts at cold-start priors (~0.2–1.0 pseudo-scores), converges toward real RAGAS+judge composites after ~50–100 queries per type.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "rag_strategy_score",
          "legendFormat": "{{strategy}} / {{query_type}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },

    {
      "id": 3,
      "type": "timeseries",
      "title": "Retrieval Latency — P50 / P95 per Strategy",
      "description": "HyDE and multi_query will show P95 latencies 5–10× higher than dense or bm25 — the cost/quality trade-off visualised. Use this to tune top_k and candidate counts.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, strategy) (rate(rag_retrieval_latency_ms_bucket[5m])))",
          "legendFormat": "P50 {{strategy}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, strategy) (rate(rag_retrieval_latency_ms_bucket[5m])))",
          "legendFormat": "P95 {{strategy}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ms",
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byNamePattern", "options": "P95.*" },
            "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }]
          }
        ]
      }
    },

    {
      "id": 4,
      "type": "timeseries",
      "title": "End-to-End Query Latency — P50 / P95",
      "description": "Full pipeline latency including retrieval + compression + generation. Target: P50 < 2 s, P95 < 6 s for a good user experience.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rag_e2e_latency_ms_bucket[5m])))",
          "legendFormat": "P50 e2e"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_e2e_latency_ms_bucket[5m])))",
          "legendFormat": "P95 e2e"
        },
        {
          "refId": "C",
          "expr": "sum(rate(rag_queries_total[5m]))",
          "legendFormat": "QPS"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ms",
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "QPS" },
            "properties": [
              { "id": "unit", "value": "reqps" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Feedback Buffer Size",
      "description": "Events queued in Redis waiting for the 60-second updater cycle. Should stay near 0. Sustained spikes (> 100) mean the updater is falling behind — check Postgres write latency.",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "rag_feedback_buffer_size",
          "legendFormat": "buffer"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red",    "value": 100 }
            ]
          },
          "mappings": [],
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Bandit Exploration Rate",
      "description": "Rate of exploration decisions / total queries. Should hover near epsilon = 15 %. Drift above 20 % may mean the cold-start forced-exploration path is dominating (strategies not accumulating enough samples). Drift to 0 means the bandit has stopped exploring.",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rag_exploration_total[5m])) / sum(rate(rag_queries_total[5m]))",
          "legendFormat": "exploration rate (all strategies)"
        },
        {
          "refId": "B",
          "expr": "rate(rag_exploration_total[5m]) / sum(rate(rag_queries_total[5m]))",
          "legendFormat": "{{strategy}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "percentunit",
          "min": 0,
          "max": 0.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "red",    "value": 0.40 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "exploration rate (all strategies)" },
            "properties": [
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      }
    }

  ],

  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["rag", "adaptive", "retrieval", "platform"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource",
        "label": "Prometheus data source"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(rag_queries_total, strategy)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "strategy",
        "query": { "query": "label_values(rag_queries_total, strategy)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Strategy"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Adaptive RAG Platform",
  "uid": "adaptive-rag-v1",
  "version": 1,
  "weekStart": ""
}
