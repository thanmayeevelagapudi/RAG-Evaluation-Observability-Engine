# Copy to .env and fill in your values.
# Never commit the real .env to source control.
# Production values use Azure-managed services; local values use docker-compose defaults.

# ── LLM ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Vector DB (Qdrant Cloud — cloud-agnostic) ──────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Search (local: Elasticsearch / Azure: Azure AI Search endpoint) ────────
ELASTICSEARCH_URL=http://localhost:9200

# ── Metadata / routing state (Azure: Azure Database for PostgreSQL) ────────
# Plain postgresql:// (not +asyncpg) — asyncpg rejects the SQLAlchemy dialect prefix
# Azure format: postgresql://user%40server:pass@server.postgres.database.azure.com/db?sslmode=require
POSTGRES_DSN=postgresql://rag:rag@localhost:5432/rag

# ── Cache / routing weights (Azure: Azure Cache for Redis) ─────────────────
# Azure format: rediss://:password@name.redis.cache.windows.net:6380
REDIS_URL=redis://localhost:6379/0

# ── Reranker ───────────────────────────────────────────────────────────────
COHERE_API_KEY=
RERANKER_PROVIDER=auto
BGE_RERANKER_MODEL=BAAI/bge-reranker-base

# ── Retrieval confidence + retry ───────────────────────────────────────────
ENABLE_CONFIDENCE_RETRY=true
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35

# ── Cost estimation (USD per 1k tokens) ───────────────────────────────────
INPUT_COST_PER_1K_TOKENS_USD=0.003
OUTPUT_COST_PER_1K_TOKENS_USD=0.015

# ── Online evaluation ──────────────────────────────────────────────────────────────────
# Fraction of live requests scored by RAGAS-style metrics + LLM judge (several LLM calls each).
EVAL_SAMPLE_RATE=1.0

# ── Observability ──────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Security ───────────────────────────────────────────────────────────────
# Required in production. If empty, auth is disabled (dev only).
API_KEY=
# Protect /metrics with API key checks when true.
METRICS_REQUIRE_API_KEY=false
# Optional dedicated metrics key. Falls back to API_KEY when empty.
METRICS_API_KEY=
# Comma-separated allowed origins. Use * for open APIs, restrict for production.
CORS_ORIGINS=*
